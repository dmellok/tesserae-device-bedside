/*
 * Copy to include/secrets.h (gitignored). Everything here is a FIRST-BOOT SEED:
 * it is written into the flash config sector the first time the firmware runs
 * (or whenever a value here differs from what is stored), and the web UI can
 * change the stored values afterwards without a rebuild.
 */
#pragma once

/* WiFi (WPA2; leave WIFI_PASS "" for an open network). */
#define WIFI_SSID        "your-ssid"
#define WIFI_PASS        "your-password"

/* Tesserae server base URL: scheme + host (IP or DNS name) + port, no path.
 * Plain http only; .local names do not resolve from the device. */
#define SERVER_URL       "http://192.168.1.50:8765"

/* Device id announced on /discover: ^[a-z][a-z0-9_-]{1,31}$. The server may
 * hand back a different id (MAC match); the firmware adopts it. */
#define DEVICE_ID        "bedside"

/* Suggested display name, prefilled on the Register card in Settings -> Devices. */
#define DEVICE_NAME      "Bedside"

/* Optional: device kind announced to the server. Default (see config.c) is the
 * server's own 10.3" IT8951 board, whose catalog entry fixes the panel at
 * 1872x1404 gray_16; use "waveshare_103_it8951_pico" once that entry from
 * tesserae/hardware/ is installed on the server. Changing it re-pairs. */
/* #define DEVICE_KIND  "waveshare_103_it8951_pico" */

/* Optional: a 6-digit pairing code from Settings -> Devices -> "Pair new
 * device". Leave undefined for the zero-touch discover flow (admin clicks
 * Register once; no typing on the device). */
/* #define PAIRING_CODE  "482917" */

/* Optional dev knobs. */
/* #define DEV_FRAME_URL "http://192.168.1.50:8765/renders/abc123def456.bin" */

/* Optional: Home Assistant MQTT broker, used until set in the web app
 * (Device tab, Home Assistant). See src/ha.c. */
/* #define MQTT_HOST "homeassistant.local" */
/* #define MQTT_PORT 1883 */
/* #define MQTT_USER "bedside" */
/* #define MQTT_PASS "..." */
